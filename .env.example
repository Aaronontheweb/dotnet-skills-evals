# OpenRouter API key for running evaluations (all models go through OpenRouter)
OPENROUTER_API_KEY=sk-or-...

# Path to local dotnet-skills repository (optional, defaults to ~/repositories/dotnet-skills)
# DOTNET_SKILLS_REPO=/path/to/dotnet-skills

# The execution-based ILSpy eval uses this same OpenRouter key (tool-capable models).
# No provider credentials are passed into its offline Docker trial containers.
# Setup and invocation: docs/ilspy-activation.md
